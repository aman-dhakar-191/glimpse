rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Storage security rules can't reference Realtime Database data, so this
    // can't check shared/settings/allowedUsers the way database.rules.json
    // does — "signed in" is the strongest check available here. Writes are
    // still scoped to the uploader's own UID-prefixed path.
    match /messages/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
