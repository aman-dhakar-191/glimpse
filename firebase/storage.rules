rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Storage security rules can't reference Realtime Database data, so this
    // can't check shared/settings/allowedUsers the way database.rules.json
    // does — "signed in" is the strongest check available here. Writes are
    // still scoped to the uploader's own UID-prefixed path.
    //
    // Namespaced under glimpse/ since this Storage bucket is shared with
    // other projects on the same Firebase project.
    match /glimpse/messages/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Videos live under their own prefix (not glimpse/messages/) — see
    // MessageRepository.sendPhotoMessage — so a future cleanup job can
    // target just this prefix for expiry without touching photos.
    match /glimpse/videos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
