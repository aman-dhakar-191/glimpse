    <color name="background">#211735</color>
    <color name="widget_bg">#2A2044</color>
    <color name="widget_border">#473563</color>
    <color name="text_primary">#F5EEFA</color>
    <color name="text_secondary">#C3B4D1</color>
    <color name="chip_bg">#3D2E4E</color>
    <color name="chip_border">#503F63</color>
    <color name="button_bg">#3D2E4E</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
</resources>
