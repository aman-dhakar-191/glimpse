<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Explicit candidate sizes (sp) for the widget's autoSizeTextType,
         used instead of autoSizeMinTextSize/MaxTextSize/StepGranularity —
         some widget hosts don't run a full two-pass measure on a
         weight-based TextView height, so the continuous min/max/step
         search can under-select badly (e.g. picking ~35sp in a box with
         room for 70sp+). A short discrete list is cheaper to evaluate and
         more consistently reliable across launchers/OEM widget hosts. -->
    <integer-array name="widget_message_autosize_presets">
        <item>14</item>
        <item>18</item>
        <item>22</item>
        <item>28</item>
        <item>34</item>
        <item>40</item>
        <item>48</item>
    </integer-array>
</resources>
