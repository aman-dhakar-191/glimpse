    <string name="guide_title">Add Widgets to Your Home Screen</string>
    <string name="guide_step_1_title">Long-press on your home screen</string>
    <string name="guide_step_1_desc">Hold your finger on an empty space</string>
    <string name="guide_step_2_title">Select \'Widgets\'</string>
    <string name="guide_step_2_desc">Tap the widgets option</string>
    <string name="guide_step_3_title">Find \'Glimpse\'</string>
    <string name="guide_step_3_desc">Search for our app — you\'ll see three widgets: \"Glimpse\", \"Glimpse (Square)\", and \"Glimpse (Large)\"</string>
    <string name="guide_step_4_title">Pick the size you want</string>
    <string name="guide_step_4_desc">\"Glimpse\" is the default 4x4 widget, \"Glimpse (Square)\" is compact, and \"Glimpse (Large)\" is a taller 4x6 with more room for photos. All resize afterward too.</string>
    <string name="guide_step_5_title">Tap React on the widget to reply with any emoji</string>
    <string name="guide_step_5_desc">Opens a quick picker right in the app</string>
    <string name="guide_dismiss">Got it, dismiss this guide</string>
    <string name="guide_logout">Log out</string>

