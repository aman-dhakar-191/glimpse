<?xml version="1.0" encoding="utf-8"?>
<!-- widget_root hosts a ViewFlipper (widget_carousel) populated dynamically
     by WidgetRenderer with one page per message in the current catch-up
     window (see WidgetRenderer.carouselWindow) — ViewFlipper is on
     RemoteViews' documented supported-container whitelist (same category as
     the plain LinearLayout this widget has always used for widget_root
     itself), and addView()-ing dynamic children into it is the same proven
     pattern this widget already uses for reaction chips
     (widget_carousel_page.xml's reactions_container), not new/untested
     RemoteViews territory. autoStart+flipInterval are plain View XML
     attributes ViewFlipper honors once inflated — no reflection-based
     RemoteViews.setInt() needed. With only one page (the common case —
     nothing unseen) it's a no-op single view, pixel-identical to the
     widget's original non-carousel rendering.

     widget_root itself is otherwise completely unchanged from the known-good
     baseline (plain LinearLayout, id, padding, plain solid
     @color/widget_bg) — see git history for why that matters: this is the
     exact structure that's never triggered "Can't load widget". -->
<LinearLayout
    android:id="@+id/widget_root"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/widget_bg">

    <ViewFlipper
        android:id="@+id/widget_carousel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="6000" />
</LinearLayout>
