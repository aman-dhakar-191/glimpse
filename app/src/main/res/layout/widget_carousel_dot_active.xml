<?xml version="1.0" encoding="utf-8"?>
<!-- The currently-selected page's dot — slightly larger and filled with
     the accent color. Tapping it re-jumps to the same page (harmless
     no-op); see widget_carousel_dot_inactive.xml for the others. -->
<View
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dot_root"
    android:layout_width="8dp"
    android:layout_height="8dp"
    android:layout_marginHorizontal="3dp"
    android:background="@drawable/widget_carousel_dot_active" />
