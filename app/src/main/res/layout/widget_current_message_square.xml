<?xml version="1.0" encoding="utf-8"?>
<!-- Compact counterpart to widget_current_message.xml for the square size
     variant — see that file for the ViewFlipper/carousel reasoning. Same
     widget_root (unchanged plain LinearLayout, known-good baseline), just
     tighter 10dp padding and widget_carousel_page_square.xml for pages. -->
<LinearLayout
    android:id="@+id/widget_root"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@color/widget_bg">

    <ViewFlipper
        android:id="@+id/widget_carousel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="6000" />
</LinearLayout>
