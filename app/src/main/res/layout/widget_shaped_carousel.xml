<?xml version="1.0" encoding="utf-8"?>
<!-- Separate widget from widget_shaped_message.xml — this one is the
     carousel variant, picked as its own distinct item in the launcher's
     "add widget" list rather than replacing the plain single-message
     Glimpse widget. See ShapedCarouselWidget/ShapedCarouselWidgetRenderer.

     Non-rectangular widget outline: a transparent root + custom silhouette
     ImageView. RemoteViews can't do real pixel-level clipping (no
     ClipPath/Outline support, and the launcher's grid cell stays
     rectangular no matter what) — this only changes what gets PAINTED
     inside that rectangle, and taps in the transparent corners outside
     the drawn shape but inside the cell still register on whatever view
     sits there. That's why the tappable content below is given its own
     inset id="widget_root" area instead of covering the full transparent
     RelativeLayout — keeps the click target roughly matching the visible
     blob instead of the whole invisible rectangle.

     RelativeLayout (not FrameLayout) for the overlapping-children
     container — FrameLayout was implicated in an earlier "Can't load
     widget" crash on this app and was swapped out precautionarily;
     RelativeLayout has been solid since. btn_react and the nested photo
     overlay below reuse the same technique for their own overlapping
     content. -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_blob_shape"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="22dp"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Author name for text-only messages only — shown/hidden opposite
             shaped_author_name_overlay below, see ShapedCarouselWidgetRenderer.
             Photo messages skip this row entirely (the overlay reads
             better directly on the photo) so it doesn't leave an empty
             gap when there's nothing else to show up here. -->
        <TextView
            android:id="@+id/shaped_author_name_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />

        <!-- Photo carries ~3x the weight of the caption below — captions
             are usually a few words, so they don't need equal billing with
             the photo itself. -->
        <RelativeLayout
            android:id="@+id/shaped_photo_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:layout_marginVertical="4dp">

            <ImageView
                android:id="@+id/shaped_message_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/shaped_author_name_overlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:layout_margin="6dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="@drawable/widget_photo_label_bg"
                android:textSize="10sp"
                android:textColor="@color/white" />
        </RelativeLayout>

        <TextView
            android:id="@+id/shaped_message_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginVertical="6dp"
            android:gravity="center"
            android:maxLines="4"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="72sp"
            android:autoSizeStepGranularity="2sp" />

        <!-- Carousel page indicator — a single bitmap drawn in code (see
             ShapedCarouselWidgetRenderer.buildDotRowBitmap), not one real
             view per dot. Purely decorative: dots aren't individually
             tappable, btn_carousel_advance below is the only way to move
             through the window. Only shown when there's more than one
             message to page through. -->
        <ImageView
            android:id="@+id/shaped_carousel_dots"
            android:layout_width="wrap_content"
            android:layout_height="10dp"
            android:layout_marginTop="2dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Icon-only quick-react, overlaid in the card's bottom-right corner
         instead of living inside widget_root's vertical flow — reads as a
         chat-bubble reaction affordance rather than a full-width button
         sitting in the blob's bottom tail notch. Aligned to widget_root's
         own edges (not the parent's) — widget_root's 22dp inset is what
         already keeps the photo/caption content inside the visible blob
         curve, and a fixed margin guessed relative to the full outer
         bounds instead landed the button outside/below the curve on a
         real device. -->
    <Button
        android:id="@+id/btn_react"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_alignBottom="@id/widget_root"
        android:layout_alignEnd="@id/widget_root"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="4dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:background="@drawable/widget_react_icon_bg"
        android:text="😊"
        android:textSize="14sp" />

    <!-- Carousel "next page" control — vertically centered on the left
         edge (not a bottom corner, so it doesn't read as just another
         corner button alongside btn_react — a slider-style side arrow
         instead). Only ever advances (see ShapedCarouselAdvanceReceiver);
         dots above are not independently tappable. Hidden whenever there's
         only one message to show (see ShapedCarouselWidgetRenderer).
         layout_centerVertical centers within the outer RelativeLayout
         rather than widget_root itself — equivalent here since
         widget_root's 22dp margin is symmetric on all sides, so both
         views share the same vertical center. -->
    <Button
        android:id="@+id/btn_carousel_advance"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_alignStart="@id/widget_root"
        android:layout_centerVertical="true"
        android:layout_marginStart="4dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:background="@drawable/widget_react_icon_bg"
        android:text="›"
        android:textSize="20sp"
        android:textStyle="bold" />
</RelativeLayout>
