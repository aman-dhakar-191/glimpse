<?xml version="1.0" encoding="utf-8"?>
<!-- EXPERIMENTAL, fully isolated shape test — validates the "transparent
     root + custom silhouette ImageView" technique for faking a non-
     rectangular widget outline. RemoteViews can't do real pixel-level
     clipping (no ClipPath/Outline support, and the launcher's grid cell
     stays rectangular no matter what) — this only changes what gets
     PAINTED inside that rectangle, and taps in the transparent corners
     outside the drawn shape but inside the cell still register on
     whatever view sits there. That's why the tappable content below is
     given its own inset id="widget_root" area instead of covering the
     full transparent RelativeLayout — keeps the click target roughly
     matching the visible blob instead of the whole invisible rectangle.

     RelativeLayout (not FrameLayout) for the overlapping-children
     container, same reasoning as the reverted widget-background-photo
     experiment (PR #39): FrameLayout was one of three suspects in the
     original historical "Can't load widget" crash and was never
     individually cleared, so a different (also RemoteViews-whitelisted)
     container class is used here instead. btn_react and the nested photo
     overlay below reuse that same RelativeLayout technique for their own
     overlapping content.

     Fully self-contained: this file, ShapedMessageWidget.kt,
     ShapedWidgetRenderer.kt, and widget_blob_shape.xml share nothing with
     the other widget providers except ReactionActionBinder's generic bind
     functions. Delete all four (plus the manifest receiver and the two
     widget_label_shaped/widget_shaped_* strings) to fully remove this
     experiment with zero impact on CurrentMessageWidget/SquareMessageWidget/
     LargeMessageWidget/LatestMessageWidget if it doesn't pan out on a real
     device. -->
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/widget_blob_shape"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="22dp"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Author name for text-only messages only — shown/hidden opposite
             shaped_author_name_overlay below, see ShapedWidgetRenderer.
             Photo messages skip this row entirely (the overlay reads
             better directly on the photo) so it doesn't leave an empty
             gap when there's nothing else to show up here. -->
        <TextView
            android:id="@+id/shaped_author_name_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />

        <!-- Photo carries ~3x the weight of the caption below — captions
             are usually a few words, so they don't need equal billing with
             the photo itself. -->
        <RelativeLayout
            android:id="@+id/shaped_photo_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:layout_marginVertical="4dp">

            <ImageView
                android:id="@+id/shaped_message_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/shaped_author_name_overlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true"
                android:layout_margin="6dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="@drawable/widget_photo_label_bg"
                android:textSize="10sp"
                android:textColor="@color/white" />
        </RelativeLayout>

        <TextView
            android:id="@+id/shaped_message_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginVertical="6dp"
            android:gravity="center"
            android:maxLines="4"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="72sp"
            android:autoSizeStepGranularity="2sp" />
    </LinearLayout>

    <!-- Icon-only quick-react, overlaid in the card's bottom-right corner
         instead of living inside widget_root's vertical flow — reads as a
         chat-bubble reaction affordance rather than a full-width button
         sitting in the blob's bottom tail notch. Margins are deliberately
         bigger than widget_root's own 22dp inset since the blob's curve
         pinches inward near the bottom-right corner specifically. -->
    <Button
        android:id="@+id/btn_react"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="28dp"
        android:layout_marginEnd="22dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:background="@drawable/widget_react_icon_bg"
        android:text="😊"
        android:textSize="14sp" />
</RelativeLayout>
