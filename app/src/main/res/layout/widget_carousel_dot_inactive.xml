<?xml version="1.0" encoding="utf-8"?>
<!-- A not-currently-selected page's dot — smaller and muted. Tapping it
     jumps the carousel straight to that page (see
     ReactionActionBinder.bindCarouselJumpAction / WidgetCarouselJumpReceiver),
     the same "app owns the index" idea driving this whole widget now that
     ViewFlipper's autoStart timer is gone. -->
<View
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dot_root"
    android:layout_width="6dp"
    android:layout_height="6dp"
    android:layout_marginHorizontal="3dp"
    android:background="@drawable/widget_carousel_dot_inactive" />
