<?xml version="1.0" encoding="utf-8"?>
<!-- A safe <shape> (GradientDrawable) primitive, deliberately NOT a
     <vector>/bezier path. This view's width is match_parent and varies a
     lot with the user's home-screen grid, and a fixed-viewport vector path
     would visibly distort at very different widths; a corner-radius shape
     degrades gracefully at any size instead. Two opposite corners rounded
     to a full pill radius and the other two kept tight gives an asymmetric
     "blob-lite" read without introducing a new drawable class into the
     widget's RemoteViews tree. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/button_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/chip_border" />
    <corners
        android:topLeftRadius="999dp"
        android:bottomRightRadius="999dp"
        android:topRightRadius="10dp"
        android:bottomLeftRadius="10dp" />
</shape>
