<?xml version="1.0" encoding="utf-8"?>
<!-- The fake outline for ShapedMessageWidget. Same path as the in-app
     BlobShapeSoftC (see ui/theme/BlobShapes.kt), ported to a vector
     drawable's 0-100 viewport by multiplying every w/h fraction by 100.
     BlobShapeSoftC was picked specifically because it's a "content-safe"
     variant — max ~10-12% edge inset instead of the ~40-50% deep pinches
     the more dramatic blob shapes have — so text inside has a real chance
     of staying clear of the curve at small widget sizes. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path
        android:pathData="M14,22 C22,8 40,4 56,7 C68,9 78,6 87,14 C96,22 94,34 91,44 C88,54 94,60 92,70 C89,84 76,94 60,94 C48,94 40,90 28,91 C14,92 6,82 6,70 C6,60 12,54 10,44 C8,34 8,30 14,22 Z"
        android:fillColor="@color/widget_bg_dark"
        android:strokeColor="@color/widget_border"
        android:strokeWidth="1.2" />
</vector>
