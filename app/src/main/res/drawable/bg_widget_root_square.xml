<?xml version="1.0" encoding="utf-8"?>
<!-- Same experiment as bg_widget_root.xml, scaled down to match the square
     layout's tighter 10dp padding (~2x2-cell widget) so the curve still
     never enters the padded content area. See bg_widget_root.xml for the
     full reasoning and revert plan. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_bg" />
    <stroke
        android:width="1.5dp"
        android:color="@color/widget_border" />
    <corners
        android:topLeftRadius="9dp"
        android:bottomRightRadius="9dp"
        android:topRightRadius="4dp"
        android:bottomLeftRadius="4dp" />
</shape>
