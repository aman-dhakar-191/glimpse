<?xml version="1.0" encoding="utf-8"?>
<!-- EXPERIMENTAL — this is the one thing widget_current_message.xml's
     comment names as suspect in the real "Can't load widget" crash on
     Xiaomi HyperOS/POCO (see ef10731). That revert actually changed THREE
     things at once (a FrameLayout wrapper, a heart badge overlapping via
     negative margins, and this background) and never isolated which one
     was the real cause — and the background itself was always just a
     plain <shape> GradientDrawable (rounded rect, no vector/bezier), the
     same drawable class already proven fine as a leaf background elsewhere
     in this widget (bg_reaction_chip.xml, bg_widget_button.xml). Trying
     just this one piece again, alone, with no wrapper and no badge, kept
     in its own commit specifically so it can be reverted independently if
     it turns out to be the real cause. Corner radii are kept at or under
     the root LinearLayout's own padding (16dp rectangular / 10dp square)
     so no content can ever land in the curve's cut zone regardless of
     what's on screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_bg" />
    <stroke
        android:width="1.5dp"
        android:color="@color/widget_border" />
    <corners
        android:topLeftRadius="14dp"
        android:bottomRightRadius="14dp"
        android:topRightRadius="6dp"
        android:bottomLeftRadius="6dp" />
</shape>
