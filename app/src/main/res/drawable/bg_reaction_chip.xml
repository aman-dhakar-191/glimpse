<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/chip_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/chip_border" />
    <!-- A radius this large just clamps to half the view's shorter side,
         giving a full stadium/pill shape regardless of content width —
         same safe <shape> primitive already used here, just rounder, to
         match the Blob Pop identity without touching anything closer to
         the "Can't load widget" crash history (see widget_current_message.xml). -->
    <corners android:radius="999dp" />
</shape>
