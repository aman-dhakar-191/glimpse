<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/chip_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/chip_border" />
    <!-- Two opposite corners clamp to a full stadium radius, the other two
         stay tight — reads as an asymmetric "blob-lite" pill instead of a
         perfectly uniform one, while staying within the same safe <shape>
         (GradientDrawable) primitive already proven fine here. A real
         bezier/vector path isn't used because each chip's width is
         wrap_content and varies per emoji/count, which would visibly
         distort a fixed-viewport vector shape; corner radii degrade
         gracefully at any width instead. Kept well clear of the widget
         ROOT's background/structure — see widget_current_message.xml for
         why that specific surface stays a plain solid color. -->
    <corners
        android:topLeftRadius="999dp"
        android:bottomRightRadius="999dp"
        android:topRightRadius="6dp"
        android:bottomLeftRadius="6dp" />
</shape>
