<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Only needed to save a photo to the gallery on Android 9 and below —
         API 29+ writes through MediaStore without this permission at all
         (scoped storage), so it's capped to the OS versions that need it. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Sideloaded (not Play Store) — installing a downloaded update APK
         needs this special permission, granted per-app via Settings, not a
         runtime dangerous-permission prompt. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Glimpse">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Glimpse">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Current Message Widget (rectangular, default 4x4) -->
        <receiver
            android:name=".widgets.CurrentMessageWidget"
            android:exported="true"
            android:label="@string/widget_label_rectangular">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_current_message_info" />
        </receiver>

        <!-- Square Message Widget — a separate provider (not a resize
             variant) so it always shows up as its own entry in the widget
             picker, regardless of whether the launcher supports Android
             12's in-place flexible-resize picker. -->
        <receiver
            android:name=".widgets.SquareMessageWidget"
            android:exported="true"
            android:label="@string/widget_label_square">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_current_message_square_info" />
        </receiver>

        <!-- Widget Update Service -->
        <service
            android:name=".service.WidgetUpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- FCM Service -->
        <service
            android:name=".service.FCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Exposes cacheDir/camera/ so the system camera app can write
             captured photos back to us without granting it broader storage
             access (needed for ActivityResultContracts.TakePicture()). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
