<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Only needed to save a photo to the gallery on Android 9 and below —
         API 29+ writes through MediaStore without this permission at all
         (scoped storage), so it's capped to the OS versions that need it. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Sideloaded (not Play Store) — installing a downloaded update APK
         needs this special permission, granted per-app via Settings, not a
         runtime dangerous-permission prompt. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Glimpse">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Glimpse">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Current Message Widget (rectangular, default 4x4) -->
        <receiver
            android:name=".widgets.CurrentMessageWidget"
            android:exported="true"
            android:label="@string/widget_label_rectangular">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_current_message_info" />
        </receiver>

        <!-- Square Message Widget — a separate provider (not a resize
             variant) so it always shows up as its own entry in the widget
             picker, regardless of whether the launcher supports Android
             12's in-place flexible-resize picker. -->
        <receiver
            android:name=".widgets.SquareMessageWidget"
            android:exported="true"
            android:label="@string/widget_label_square">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_current_message_square_info" />
        </receiver>

        <!-- Large Message Widget (4x6) — a separate provider so it's a
             guaranteed, always-visible entry in the widget picker. -->
        <receiver
            android:name=".widgets.LargeMessageWidget"
            android:exported="true"
            android:label="@string/widget_label_large">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_current_message_large_info" />
        </receiver>

        <!-- Latest Message Widget — a separate provider offered alongside
             the default carousel-enabled one, for anyone who'd rather the
             widget just stay on the newest message instead of auto-
             advancing through a catch-up backlog. Add either, or both. -->
        <receiver
            android:name=".widgets.LatestMessageWidget"
            android:exported="true"
            android:label="@string/widget_label_latest">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_latest_message_info" />
        </receiver>

        <!-- Handles a tap on one of the carousel's page dots — jumps that
             one appWidgetId to the tapped page. Not exported: only ever
             invoked via a PendingIntent this app itself created. -->
        <receiver
            android:name=".widgets.WidgetCarouselJumpReceiver"
            android:exported="false" />

        <!-- EXPERIMENTAL: Shaped Message Widget — validates faking a non-
             rectangular widget silhouette via a transparent root + custom
             blob ImageView (real per-pixel touch/clip isn't possible in
             RemoteViews; this only changes what's painted, not the
             underlying rectangular grid cell or touch bounds). Fully
             isolated from the other widgets — see ShapedMessageWidget/
             ShapedWidgetRenderer/widget_shaped_message.xml for the full
             reasoning and revert plan. -->
        <receiver
            android:name=".widgets.ShapedMessageWidget"
            android:exported="true"
            android:label="@string/widget_label_shaped">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_shaped_message_info" />
        </receiver>

        <!-- Widget Update Service -->
        <service
            android:name=".service.WidgetUpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- FCM Service -->
        <service
            android:name=".service.FCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Quick Settings tile — a swipe-down-and-tap shortcut straight to
             Compose, faster than finding the home-screen widget. -->
        <service
            android:name=".service.ComposeTileService"
            android:exported="true"
            android:icon="@drawable/ic_heart"
            android:label="@string/qs_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Exposes cacheDir/camera/ so the system camera app can write
             captured photos back to us without granting it broader storage
             access (needed for ActivityResultContracts.TakePicture()). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
